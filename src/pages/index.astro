---
import '../styles/global.css';

const links = [
  { label: 'GitHub', href: 'https://github.com/arcele', icon: 'github' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/jryankelley', icon: 'linkedin' },
  { label: 'Email', href: 'mailto:ryan@jryky.com', icon: 'email' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#07131d" media="(prefers-color-scheme: dark)" />
    <meta
      name="description"
      content="The personal homepage of J. Ryan Kelley — software engineer, internet tinkerer, and dog enthusiast."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>J. Ryan Kelley — Software Engineer</title>
  </head>
  <body>
    <a class="skip-link" href="#about">Skip to introduction</a>

    <main>
      <header class="hero" aria-labelledby="site-title">
        <canvas class="orbit-field" aria-hidden="true"></canvas>
        <div class="hero-glow" aria-hidden="true"></div>

        <div class="hero-content">
          <p class="eyebrow">J. Ryan Kelley</p>
          <h1 id="site-title">
            <span class="wordmark" role="img" aria-label="jryky">jryky</span>
          </h1>
          <p class="role">software engineer <span aria-hidden="true">/</span> internet tinkerer</p>
        </div>

        <nav class="social-nav" aria-label="Find Ryan online">
          {links.map((link) => (
            <a
              href={link.href}
              class="social-link"
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
            >
              <span class="social-icon" aria-hidden="true">
                {link.icon === 'github' && (
                  <svg viewBox="0 0 24 24"><path d="M12 .7A11.5 11.5 0 0 0 8.4 23c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1.1-.8.1-.8.1-.8 1.3.1 2 1.3 2 1.3 1.1 2 3 1.4 3.7 1 .1-.8.4-1.4.8-1.7-2.7-.3-5.5-1.3-5.5-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0C16.7 3.5 17.7 3.8 17.7 3.8c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.8 5.5-5.5 5.8.4.4.8 1.1.8 2.2v4.4c0 .4.2.7.8.6A11.5 11.5 0 0 0 12 .7Z" /></svg>
                )}
                {link.icon === 'linkedin' && (
                  <svg viewBox="0 0 24 24"><path d="M5.2 7.8H1.4V22h3.8V7.8ZM3.3 1A2.3 2.3 0 1 0 3.3 5.6 2.3 2.3 0 0 0 3.3 1ZM22.6 13.8c0-4.3-2.3-6.4-5.4-6.4-2.5 0-3.6 1.4-4.2 2.3V7.8H9.2V22H13v-7c0-1.8.4-3.6 2.7-3.6 2.3 0 2.3 2.1 2.3 3.8V22h3.8l.8-8.2Z" /></svg>
                )}
                {link.icon === 'email' && (
                  <svg viewBox="0 0 24 24"><path d="M2.5 4h19A2.5 2.5 0 0 1 24 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-19A2.5 2.5 0 0 1 0 17.5v-11A2.5 2.5 0 0 1 2.5 4Zm9.5 9L2.7 6.4c-.4-.3-.8.4-.4.7l8.3 7.3c.8.7 2 .7 2.8 0l8.3-7.3c.4-.3 0-1-.4-.7L12 13Z" /></svg>
                )}
              </span>
              <span class="social-label">{link.label}</span>
            </a>
          ))}
        </nav>

        <div class="scroll-cue" aria-hidden="true"><span></span></div>
      </header>

      <section class="intro" id="about" aria-labelledby="intro-title">
        <div class="intro-card">
          <div class="portrait-wrap">
            <img src="/assets/ryan.jpg" alt="Ryan Kelley" width="460" height="460" />
            <span class="portrait-orbit" aria-hidden="true"></span>
          </div>
          <div class="intro-copy">
            <h2 id="intro-title">Hey, I’m Ryan.</h2>
            <p>
              I guess this is my homepage. Wait, are homepages still a thing?
            </p>
            <p class="aside">
              I’ve been building things on the internet since 1994.  Sometimes professionally,
              sometimes because I wanted to.
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <p>Built for the weird, wonderful internet.</p>
      <p>&copy; {new Date().getFullYear()} J. Ryan Kelley</p>
    </footer>

    <script>
      import '../scripts/orbit-field.ts';
    </script>
  </body>
</html>
