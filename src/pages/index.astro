---
import '../styles/global.css';

const links = [
  { label: 'GitHub', href: 'https://github.com/arcele', icon: 'github' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/jryankelley', icon: 'linkedin' },
  { label: 'Email', href: 'mailto:ryan@jryky.com', icon: 'email' },
] as const;

const projects = [
  {
    name: 'Free Jumbo Jack',
    url: 'https://freejumbojack.com',
    domain: 'freejumbojack.com',
    image: '/assets/projects/burger-sm.png',
    description:
      'The Padres give out free cheeseburgers whenever they hit a homer the previous night.  This is a one stop shop to see if San Diegans can get that free burger.  It also serves some other markets like Los Angeles and Arizona, and even some football teams who have similar giveaways.',
  },
  {
    name: 'When We Match',
    url: 'https://whenwematch.com',
    domain: 'whenwematch.com',
    image: '/assets/projects/when-we-match.svg',
    description:
      'You ever wonder when your human years exactly match how old your dog is in dog years?  Yeah, don\'t worry, neither have most other sane people, but I did.  And I made a site for you to plug in your date of birth and your dog\'s date of birth to find that exact time.',
  },
  {
    name: 'Numbereeno',
    url: 'https://numbereeno.com',
    domain: 'numbereeno.com',
    image: '/assets/projects/numbereeno.svg',
    description:
      'Way back in the day, this was just a sketch on SquareONE television.  I thought it was neat then, and many years later I turned it into a website.  It\'s easy to pick up on, so check it out.',
  },
  {
    name: 'Cochl',
    url: 'https://cochl.com',
    domain: 'cochl.com',
    image: '/assets/projects/cochl.svg',
    description:
      'A scrappy top-down racing game with rival cars, damage, lap timing, and a healthy respect for walls.',
  },
] as const;

const siteUrl = 'https://jryky.com/';
const title = 'J. Ryan Kelley — Software Engineer';
const description =
  'The personal homepage of J. Ryan Kelley — software engineer, internet tinkerer, and dog enthusiast.';
const profileImage = new URL('/assets/ryan.jpg', siteUrl).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'J. Ryan Kelley',
  alternateName: 'jryky',
  url: siteUrl,
  image: profileImage,
  jobTitle: 'Software Engineer',
  sameAs: ['https://github.com/arcele', 'https://www.linkedin.com/in/jryankelley'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#07131d" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <meta name="author" content="J. Ryan Kelley" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={siteUrl} />

    <meta property="og:type" content="profile" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="jryky" />
    <meta property="og:image" content={profileImage} />
    <meta property="og:image:width" content="460" />
    <meta property="og:image:height" content="460" />
    <meta property="og:image:alt" content="Portrait of J. Ryan Kelley" />
    <meta property="profile:first_name" content="Ryan" />
    <meta property="profile:last_name" content="Kelley" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={profileImage} />
    <meta name="twitter:image:alt" content="Portrait of J. Ryan Kelley" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#about">Skip to introduction</a>

    <main>
      <header class="hero" aria-labelledby="site-title">
        <canvas class="orbit-field" aria-hidden="true"></canvas>
        <div class="hero-glow" aria-hidden="true"></div>

        <div class="hero-content">
          <p class="eyebrow">J. Ryan Kelley</p>
          <h1 id="site-title">
            <span class="wordmark" role="img" aria-label="jryky">jryky</span>
          </h1>
          <!--
          <p class="role">software engineer <span aria-hidden="true">/</span> internet tinkerer</p>
          -->
        </div>

        <nav class="social-nav" aria-label="Find Ryan online">
          {links.map((link) => (
            <a
              href={link.href}
              class="social-link"
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'me noreferrer' : undefined}
            >
              <span class="social-icon" aria-hidden="true">
                {link.icon === 'github' && (
                  <svg viewBox="0 0 24 24"><path d="M12 .7A11.5 11.5 0 0 0 8.4 23c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1.1-.8.1-.8.1-.8 1.3.1 2 1.3 2 1.3 1.1 2 3 1.4 3.7 1 .1-.8.4-1.4.8-1.7-2.7-.3-5.5-1.3-5.5-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0C16.7 3.5 17.7 3.8 17.7 3.8c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.8 5.5-5.5 5.8.4.4.8 1.1.8 2.2v4.4c0 .4.2.7.8.6A11.5 11.5 0 0 0 12 .7Z" /></svg>
                )}
                {link.icon === 'linkedin' && (
                  <svg viewBox="0 0 24 24"><path d="M5.2 7.8H1.4V22h3.8V7.8ZM3.3 1A2.3 2.3 0 1 0 3.3 5.6 2.3 2.3 0 0 0 3.3 1ZM22.6 13.8c0-4.3-2.3-6.4-5.4-6.4-2.5 0-3.6 1.4-4.2 2.3V7.8H9.2V22H13v-7c0-1.8.4-3.6 2.7-3.6 2.3 0 2.3 2.1 2.3 3.8V22h3.8l.8-8.2Z" /></svg>
                )}
                {link.icon === 'email' && (
                  <svg viewBox="0 0 24 24"><path d="M2.5 4h19A2.5 2.5 0 0 1 24 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-19A2.5 2.5 0 0 1 0 17.5v-11A2.5 2.5 0 0 1 2.5 4Zm9.5 9L2.7 6.4c-.4-.3-.8.4-.4.7l8.3 7.3c.8.7 2 .7 2.8 0l8.3-7.3c.4-.3 0-1-.4-.7L12 13Z" /></svg>
                )}
              </span>
              <span class="social-label">{link.label}</span>
            </a>
          ))}
        </nav>

        <div class="scroll-cue" aria-hidden="true"><span></span></div>
      </header>

      <section class="intro" id="about" aria-labelledby="intro-title">
        <div class="intro-card">
          <div class="portrait-wrap">
            <img src="/assets/ryan.jpg" alt="Ryan Kelley" width="460" height="460" />
            <span class="portrait-orbit" aria-hidden="true"></span>
          </div>
          <div class="intro-copy">
            <h2 id="intro-title">Hey, I’m Ryan.</h2>
            <p>
              I guess this is my homepage. Wait, are homepages still a thing?
            </p>
            <p class="aside">
              I’ve been building things on the internet since 1994.  Sometimes professionally,
              sometimes because I wanted to.
            </p>
          </div>
        </div>
      </section>

      <section class="projects" id="projects" aria-labelledby="projects-title">
        <div class="projects-inner">
          <p class="section-label">Made for the internet</p>
          <h2 id="projects-title">A few things I’ve built.</h2>

          <ul class="project-list">
            {projects.map((project) => (
              <li>
                <a class="project-card" href={project.url} target="_blank" rel="noreferrer">
                  <span class="project-image" aria-hidden="true">
                    <img src={project.image} alt="" width="160" height="160" loading="lazy" />
                  </span>
                  <span class="project-copy">
                    <span class="project-name">{project.name}</span>
                    <span class="project-description">{project.description}</span>
                    <span class="project-domain">
                      {project.domain}
                      <svg viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M5 3h8v8M13 3 4 12" />
                      </svg>
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </main>

    <footer>
      <p>Built for the weird, wonderful internet.</p>
      <p>&copy; {new Date().getFullYear()} J. Ryan Kelley</p>
    </footer>

    <script>
      import '../scripts/orbit-field.ts';
    </script>
  </body>
</html>
